                    Categorias
                </a>
                <div class="dropdown-menu" aria-labelledby="navbarDropdownCategorias">
                    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                        <a class="dropdown-item" href="/categorias/new">Cadastrar Categoria</a>
                    <% } %>
                    <a class="dropdown-item" href="/categorias">Listar Categorias</a>
                </div>
            </li>

            <!-- Dropdown Produtos -->
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownProdutos" role="button"
                    data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    Produtos
                </a>
                <div class="dropdown-menu" aria-labelledby="navbarDropdownProdutos">
                    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                        <a class="dropdown-item" href="/produtos/new">Cadastrar Produto</a>
                    <% } %>
                    <a class="dropdown-item" href="/produtos">Listar Produtos</a>
                </div>
            </li>
        </ul>

        <ul class="navbar-nav ml-auto">
