<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <a class="navbar-brand" href="/">CRUD</a>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav mr-auto">
            <li class="nav-item">
                <a class="nav-link" href="/">Home</a>
            </li>

            <!-- Dropdown Users -->
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownUsers" role="button"
                    data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    Usuários
                </a>
                <div class="dropdown-menu" aria-labelledby="navbarDropdownUsers">
                    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                        <div class="dropdown-header">
                            Logado como: <strong><%= currentUser.username %></strong> (<%= currentUser.role %>)
                        </div>
                        <div class="dropdown-divider"></div>
                        <% if (currentUser.role === 'admin') { %>
                            <a class="dropdown-item" href="/users/new">Cadastrar Usuário</a>
                            <a class="dropdown-item" href="/users">Listar Usuários</a>
                            <div class="dropdown-divider"></div>
                        <% } %>
                        <form action="/logout" method="POST" class="px-2 py-1">
                            <button type="submit" class="btn btn-outline-danger btn-block btn-sm">Logout</button>
                        </form>
                    <% } else { %>
                        <a class="dropdown-item" href="/users/new">Cadastrar Usuário</a>
                        <a class="dropdown-item text-primary font-weight-bold" href="/login">Login</a>
                    <% } %>
                </div>
            </li>

            <!-- Dropdown Categorias -->
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownCategorias" role="button"
                    data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    Categorias
                </a>
                <div class="dropdown-menu" aria-labelledby="navbarDropdownCategorias">
                    <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin') { %>
                        <a class="dropdown-item" href="/categorias/new">Cadastrar Categoria</a>
                    <% } %>
                    <a class="dropdown-item" href="/categorias">Listar Categorias</a>
                </div>
            </li>

            <!-- Dropdown Produtos -->
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownProdutos" role="button"
                    data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    Produtos
                </a>
                <div class="dropdown-menu" aria-labelledby="navbarDropdownProdutos">
                    <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin') { %>
                        <a class="dropdown-item" href="/produtos/new">Cadastrar Produto</a>
                    <% } %>
                    <a class="dropdown-item" href="/produtos">Listar Produtos</a>
                </div>
            </li>
        </ul>
