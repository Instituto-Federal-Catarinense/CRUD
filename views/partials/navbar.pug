nav.navbar.navbar-expand-lg.navbar-light.bg-light
  a.navbar-brand(href="/") CRUD
  button.navbar-toggler(type="button", data-toggle="collapse", data-target="#navbarNav", aria-controls="navbarNav", aria-expanded="false", aria-label="Toggle navigation")
    span.navbar-toggler-icon

  .collapse.navbar-collapse#navbarNav
    ul.navbar-nav
      li.nav-item
        a.nav-link(href="/") Home

      // Dropdown Usuários
      li.nav-item.dropdown
        a.nav-link.dropdown-toggle(href="#", id="navbarDropdownUsers", role="button", data-toggle="dropdown", aria-haspopup="true", aria-expanded="false") Usuários
        .dropdown-menu(aria-labelledby="navbarDropdownUsers")
          a.dropdown-item(href="/users/new") Cadastrar Usuário
          a.dropdown-item(href="/users") Listar Usuários

      // Dropdown Categorias
      li.nav-item.dropdown
        a.nav-link.dropdown-toggle(href="#", id="navbarDropdownCategorias", role="button", data-toggle="dropdown", aria-haspopup="true", aria-expanded="false") Categorias
        .dropdown-menu(aria-labelledby="navbarDropdownCategorias")
          a.dropdown-item(href="/categorias/new") Cadastrar Categoria
          a.dropdown-item(href="/categorias") Listar Categorias

      // Dropdown Produtos
      li.nav-item.dropdown
        a.nav-link.dropdown-toggle(href="#", id="navbarDropdownProdutos", role="button", data-toggle="dropdown", aria-haspopup="true", aria-expanded="false") Produtos
        .dropdown-menu(aria-labelledby="navbarDropdownProdutos")
          a.dropdown-item(href="/produtos/new") Cadastrar Produto
          a.dropdown-item(href="/produtos") Listar Produtos
    ul.navbar-nav.ml-auto
      if user
        li.nav-item
          span.nav-link Olá, #[strong= user.username]
        li.nav-item
          a.nav-link(href="/logout") Sair
      else
        li.nav-item
          a.nav-link(href="/login") Entrar
