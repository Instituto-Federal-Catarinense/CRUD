<!DOCTYPE html>

<html>

<head>

    <title>Login</title>

</head>

<body>

<h2>Login</h2>

<form action="/users/login" method="POST">

<label>Usuário</label>

<input
type="text"
name="username"
required>

<br><br>

<label>Senha</label>

<input
type="password"
name="password"
required>

<br><br>

<button type="submit">Entrar</button>

<p>
    Não possui uma conta?
    <a href="/users/register">Cadastre-se</a>
</p>

</form>

</body>

</html>