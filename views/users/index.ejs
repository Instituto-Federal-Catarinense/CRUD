<h1>Lista de usuários</h1>

<form id="searchForm" method="GET" action="/users">
    <div class="form-group">
        <label for="search">Buscar Usuário:</label>
        <input type="text" id="search" name="search" class="form-control" placeholder="Digite o nome do usuário" autocomplete="off">
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Regra</th>
            <th>Ação</th>
        </tr>
    </thead>
    <tbody id="userTableBody">
        <% users.forEach(user => { %>
            <tr>
                <td><%= user.id %></td>
                <td><%= user.username %></td>
                <td><%= user.role %></td>
                <td>
                    <a href="/users/<%= user.id %>" class="btn btn-primary">View</a>
                    <a href="/users/<%= user.id %>/edit" class="btn btn-warning">Edit</a>
                    <form action="/users/<%= user.id %>?_method=DELETE" method="POST" style="display: inline;">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

<script>
    const searchInput = document.getElementById('search');
    const tbody = document.getElementById('userTableBody');
    const searchCacheKey = 'crudUsersSearch';

    function renderUsers(users) {
        tbody.innerHTML = '';

        users.forEach(user => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${user.id}</td>
                <td>${user.username}</td>
                <td>${user.role}</td>
                <td>
                    <a href="/users/${user.id}" class="btn btn-primary">View</a>
                    <a href="/users/${user.id}/edit" class="btn btn-warning">Edit</a>
                    <form action="/users/${user.id}?_method=DELETE" method="POST" style="display: inline;">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </td>
            `;
            tbody.appendChild(tr);
        });
    }

    function fetchUsers(searchValue) {
        fetch(`/users/search?search=${encodeURIComponent(searchValue)}`)
            .then(response => response.json())
            .then(data => {
                renderUsers(data.users);
                saveUsersToLocalStorage(data.users);
                localStorage.setItem(searchCacheKey, searchValue);
            })
            .catch(error => {
                console.error('Error:', error);
                const cachedUsers = getUsersFromLocalStorage();
                if (cachedUsers.length) {
                    renderUsers(cachedUsers);
                }
            });
    }

    function loadCachedUsers() {
        const cachedUsers = getUsersFromLocalStorage();
        const savedSearch = localStorage.getItem(searchCacheKey);

        if (savedSearch) {
            searchInput.value = savedSearch;
            fetchUsers(savedSearch);
        } else if (cachedUsers.length) {
            renderUsers(cachedUsers);
        }
    }

    searchInput.addEventListener('input', function() {
        fetchUsers(this.value);
    });

    loadCachedUsers();
</script>
