<h1>Login</h1>

<form action="/login" method="POST">

    <div class="form-group">
        <label for="username">Usuário</label>

        <input
            type="text"
            id="username"
            name="username"
            required
        >
    </div>

    <div class="form-group">
        <label for="password">Senha</label>

        <input
            type="password"
            id="password"
            name="password"
            required
        >
    </div>

    <button type="submit">
        Entrar
    </button>

</form>