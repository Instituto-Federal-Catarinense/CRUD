<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-5">
        <div class="glass-card p-5 text-center">
            <h2 class="mb-2" style="font-weight: 700; color: #ff416c;">SISTEMA SEGURO</h2>
            <p class="text-muted mb-4" style="color: rgba(255,255,255,0.7) !important;">Identifique-se para acessar o painel</p>
            
            <form action="/login" method="POST" class="text-left">
                <div class="form-group">
                    <label for="username" style="font-weight: 500; letter-spacing: 0.5px;">Usuário</label>
                    <input type="text" name="username" id="username" class="form-control" required placeholder="Ex: pedro">
                </div>
                <div class="form-group mt-4">
                    <label for="password" style="font-weight: 500; letter-spacing: 0.5px;">Senha</label>
                    <input type="password" name="password" id="password" class="form-control" required placeholder="••••••••">
                </div>
                <button type="submit" class="btn btn-custom btn-block mt-5">INICIAR SESSÃO</button>
            </form>
        </div>
    </div>
</div>
