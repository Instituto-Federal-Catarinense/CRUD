<h1>Editar produto</h1>

<form
    action="/produtos/<%= produto.id %>?_method=PUT"
    method="POST"
>
    <div>
        <label for="nome">Nome</label>

        <input
            id="nome"
            name="nome"
            value="<%= produto.nome %>"
            required
        >
    </div>

    <div>
        <label for="descricao">Descrição</label>

        <textarea
            id="descricao"
            name="descricao"
        ><%= produto.descricao || '' %></textarea>
    </div>

    <div>
        <label for="preco">Preço</label>

        <input
            id="preco"
            name="preco"
            type="number"
            min="0.01"
            step="0.01"
            value="<%= produto.preco %>"
            required
        >
    </div>

    <div>
        <label for="tamanho">Tamanho</label>

        <input
            id="tamanho"
            name="tamanho"
            value="<%= produto.tamanho || '' %>"
        >
    </div>

    <div>
        <label for="imagem_url">URL da imagem</label>

        <input
            id="imagem_url"
            name="imagem_url"
            type="url"
            value="<%= produto.imagem_url || '' %>"
        >
    </div>

    <div>
        <label for="obs">Observação</label>

        <textarea
            id="obs"
            name="obs"
        ><%= produto.obs || '' %></textarea>
    </div>

    <div>
        <label for="disponivel">
            <input
                id="disponivel"
                name="disponivel"
                type="checkbox"
                value="1"
                <%= produto.disponivel ? 'checked' : '' %>
            >

            Produto disponível
        </label>
    </div>

    <button type="submit">Salvar</button>

    <a href="/produtos">Cancelar</a>
</form>