<div class="jumbotron text-center">
    <h1>Bem-vindo ao Sistema de Gerenciamento</h1>
    <p class="lead">Gerencie seus usuários e produtos sem esforço.</p>
    <% if (user) { %>
        <a href="/dashboard" class="btn btn-custom">Ir para Dashboard</a>
        <% } else { %>
            <a href="/auth/login" class="btn btn-custom">Fazer Login</a>
            <a href="/auth/register" class="btn btn-custom ml-2">Registrar-se</a>
            <% } %>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="feature-card">
            <h3>Gerenciamento de usuários</h3>
            <p>Adicione, edite e exclua usuários facilmente com nossa interface intuitiva.</p>
            <% if (user) { %>
                <a href="/users" class="btn btn-primary">Ir para usuários</a>
                <% } else { %>
                    <a href="/auth/login" class="btn btn-primary">Faça login para acessar</a>
                    <% } %>
        </div>
    </div>
    <div class="col-md-6">
        <div class="feature-card">
            <h3>Gerenciamento de produtos</h3>
            <p>Acompanhe seus produtos e seus detalhes perfeitamente.</p>
            <% if (user) { %>
                <a href="/produtos" class="btn btn-primary">Ir para produtos</a>
                <% } else { %>
                    <a href="/auth/login" class="btn btn-primary">Faça login para acessar</a>
                    <% } %>
        </div>
    </div>
</div>