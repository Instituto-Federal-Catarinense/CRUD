<h1>Cadastrar cliente</h1>

<form action="/clientes" method="POST">
    <div class="card mb-4">
        <div class="card-header">
            <strong>Dados pessoais</strong>
        </div>

        <div class="card-body">
            <div class="form-group">
                <label for="nome">Nome</label>

                <input
                    id="nome"
                    name="nome"
                    class="form-control"
                    maxlength="80"
                    required
                >
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label for="email">E-mail</label>

                    <input
                        id="email"
                        name="email"
                        type="email"
                        class="form-control"
                        maxlength="80"
                    >
                </div>

                <div class="form-group col-md-6">
                    <label for="telefone">Telefone</label>

                    <input
                        id="telefone"
                        name="telefone"
                        class="form-control"
                        maxlength="15"
                        placeholder="(48) 99999-9999"
                    >
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label for="cpf">CPF</label>

                    <input
                        id="cpf"
                        name="cpf"
                        class="form-control"
                        maxlength="14"
                        placeholder="000.000.000-00"
                    >
                </div>

                <div class="form-group col-md-6">
                    <label for="instituicao">
                        Instituição
                    </label>

                    <input
                        id="instituicao"
                        name="instituicao"
                        class="form-control"
                        maxlength="80"
                    >
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <strong>Endereço</strong>
            <small class="text-muted">
                — opcional
            </small>
        </div>

        <div class="card-body">
            <p class="text-muted">
                Para cadastrar um endereço, preencha pelo
                menos rua, bairro e município.
            </p>

            <div class="form-row">
                <div class="form-group col-md-8">
                    <label for="rua">Rua</label>

                    <input
                        id="rua"
                        name="rua"
                        class="form-control"
                        maxlength="80"
                    >
                </div>

                <div class="form-group col-md-4">
                    <label for="numero">Número</label>

                    <input
                        id="numero"
                        name="numero"
                        class="form-control"
                        maxlength="10"
                    >
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label for="bairro">Bairro</label>

                    <input
                        id="bairro"
                        name="bairro"
                        class="form-control"
                        maxlength="40"
                    >
                </div>

                <div class="form-group col-md-6">
                    <label for="municipio">Município</label>

                    <input
                        id="municipio"
                        name="municipio"
                        class="form-control"
                        maxlength="60"
                    >
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-4">
                    <label for="cep">CEP</label>

                    <input
                        id="cep"
                        name="cep"
                        class="form-control"
                        maxlength="9"
                        placeholder="00000-000"
                    >
                </div>

                <div class="form-group col-md-8">
                    <label for="ponto_referencia">
                        Ponto de referência
                    </label>

                    <input
                        id="ponto_referencia"
                        name="ponto_referencia"
                        class="form-control"
                        maxlength="100"
                    >
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        Cadastrar
    </button>

    <a href="/clientes" class="btn btn-secondary">
        Cancelar
    </a>
</form>