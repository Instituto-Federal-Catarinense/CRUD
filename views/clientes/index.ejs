<h1>Lista de clientes</h1>

<form id="formPesquisa">
    <div>
        <label for="search">Buscar cliente:</label>

        <input
            type="text"
            id="search"
            name="search"
            placeholder="Digite o nome do cliente"
            autocomplete="off"
        >
    </div>
</form>

<p>
    <a href="/clientes/new">
        Cadastrar novo cliente
    </a>
</p>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>E-mail</th>
            <th>Telefone</th>
            <th>CPF</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody id="tabelaClientes">
        <% clientes.forEach(function(cliente) { %>
            <tr>
                <td><%= cliente.id %></td>
                <td><%= cliente.nome %></td>
                <td><%= cliente.email || '' %></td>
                <td><%= cliente.telefone || '' %></td>
                <td><%= cliente.cpf || '' %></td>

                <td>
                    <a href="/clientes/<%= cliente.id %>">
                        Visualizar
                    </a>

                    <a href="/clientes/<%= cliente.id %>/edit">
                        Editar
                    </a>

                    <form
                        action="/clientes/<%= cliente.id %>?_method=DELETE"
                        method="POST"
                        style="display: inline;"
                        onsubmit="return confirm('Deseja excluir este cliente?')"
                    >
                        <button type="submit">
                            Excluir
                        </button>
                    </form>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

<script>
    const campoPesquisa = document.getElementById('search');
    const tabelaClientes = document.getElementById(
        'tabelaClientes'
    );

    campoPesquisa.addEventListener('input', async () => {
        try {
            const pesquisa = encodeURIComponent(
                campoPesquisa.value
            );

            const resposta = await fetch(
                `/clientes/search?search=${pesquisa}`
            );

            if (!resposta.ok) {
                throw new Error(
                    'Não foi possível pesquisar clientes'
                );
            }

            const dados = await resposta.json();

            tabelaClientes.innerHTML = '';

            dados.clientes.forEach((cliente) => {
                const linha = document.createElement('tr');

                linha.innerHTML = `
                    <td>${cliente.id}</td>
                    <td>${cliente.nome}</td>
                    <td>${cliente.email || ''}</td>
                    <td>${cliente.telefone || ''}</td>
                    <td>${cliente.cpf || ''}</td>

                    <td>
                        <a href="/clientes/${cliente.id}">
                            Visualizar
                        </a>

                        <a href="/clientes/${cliente.id}/edit">
                            Editar
                        </a>

                        <form
                            action="/clientes/${cliente.id}?_method=DELETE"
                            method="POST"
                            style="display: inline;"
                            onsubmit="return confirm('Deseja excluir este cliente?')"
                        >
                            <button type="submit">
                                Excluir
                            </button>
                        </form>
                    </td>
                `;

                tabelaClientes.appendChild(linha);
            });
        } catch (erro) {
            console.error(erro);
        }
    });
</script>