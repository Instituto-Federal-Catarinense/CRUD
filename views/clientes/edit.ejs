<h1>Editar cliente</h1>

<form
    action="/clientes/<%= cliente.id %>?_method=PUT"
    method="POST"
>
    <div class="card mb-4">
        <div class="card-header">
            <strong>Dados pessoais</strong>
        </div>

        <div class="card-body">
            <div class="form-group">
                <label for="nome">Nome</label>

                <input
                    id="nome"
                    name="nome"
                    class="form-control"
                    maxlength="80"
                    value="<%= cliente.nome %>"
                    required
                >
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label for="email">E-mail</label>

                    <input
                        id="email"
                        name="email"
                        type="email"
                        class="form-control"
                        maxlength="80"
                        value="<%= cliente.email || '' %>"
                    >
                </div>

                <div class="form-group col-md-6">
                    <label for="telefone">Telefone</label>

                    <input
                        id="telefone"
                        name="telefone"
                        class="form-control"
                        maxlength="15"
                        value="<%= cliente.telefone || '' %>"
                    >
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label for="cpf">CPF</label>

                    <input
                        id="cpf"
                        name="cpf"
                        class="form-control"
                        maxlength="14"
                        value="<%= cliente.cpf || '' %>"
                    >
                </div>

                <div class="form-group col-md-6">
                    <label for="instituicao">
                        Instituição
                    </label>

                    <input
                        id="instituicao"
                        name="instituicao"
                        class="form-control"
                        maxlength="80"
                        value="<%= cliente.instituicao || '' %>"
                    >
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <strong>Endereço</strong>
            <small class="text-muted">
                — opcional
            </small>
        </div>

        <div class="card-body">
            <p class="text-muted">
                Apague todos os campos para remover o endereço
                do cliente.
            </p>

            <div class="form-row">
                <div class="form-group col-md-8">
                    <label for="rua">Rua</label>

                    <input
                        id="rua"
                        name="rua"
                        class="form-control"
                        maxlength="80"
                        value="<%= cliente.rua || '' %>"
                    >
                </div>

                <div class="form-group col-md-4">
                    <label for="numero">Número</label>

                    <input
                        id="numero"
                        name="numero"
                        class="form-control"
                        maxlength="10"
                        value="<%= cliente.numero || '' %>"
                    >
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label for="bairro">Bairro</label>

                    <input
                        id="bairro"
                        name="bairro"
                        class="form-control"
                        maxlength="40"
                        value="<%= cliente.bairro || '' %>"
                    >
                </div>

                <div class="form-group col-md-6">
                    <label for="municipio">Município</label>

                    <input
                        id="municipio"
                        name="municipio"
                        class="form-control"
                        maxlength="60"
                        value="<%= cliente.municipio || '' %>"
                    >
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-4">
                    <label for="cep">CEP</label>

                    <input
                        id="cep"
                        name="cep"
                        class="form-control"
                        maxlength="9"
                        value="<%= cliente.cep || '' %>"
                    >
                </div>

                <div class="form-group col-md-8">
                    <label for="ponto_referencia">
                        Ponto de referência
                    </label>

                    <input
                        id="ponto_referencia"
                        name="ponto_referencia"
                        class="form-control"
                        maxlength="100"
                        value="<%= cliente.ponto_referencia || '' %>"
                    >
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        Salvar
    </button>

    <a
        href="/clientes/<%= cliente.id %>"
        class="btn btn-secondary"
    >
        Cancelar
    </a>
</form>